<%- include('partials/header') %>

    <main class="container">
        <div class="page-content">
            <h1>Gerenciamento de Produtos</h1>

            <!-- Formulário de Cadastro / Edição -->
            <div class="form-section">
                <h2><%= produtoEditando ? "Editar Produto" : "Cadastrar Novo Produto" %></h2>

                <form action="<%= produtoEditando ? '/atualizar/' + produtoEditando.id : '/produtos' %>" method="POST" class="product-form">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="nome">Nome do Produto</label>
                            <input type="text" id="nome" name="nome" value="<%= produtoEditando ? produtoEditando.nome : '' %>" placeholder="Ex: Arroz 5kg" required>
                        </div>

                        <div class="form-group">
                            <label for="preco">Preço (R$)</label>
                            <input type="number" id="preco" name="preco" step="0.01" min="0" value="<%= produtoEditando ? produtoEditando.preco : '' %>" placeholder="Ex: 12.90" required>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">
                            <%= produtoEditando ? "Atualizar Produto" : "Adicionar Produto" %>
                        </button>
                        <% if (produtoEditando) { %>
                            <a href="/produtos" class="btn btn-secondary">Cancelar</a>
                        <% } %>
                    </div>
                </form>
            </div>

            <!-- Busca de Produtos -->
            <div class="search-section">
                <h2>Buscar Produto</h2>
                <input type="text" id="search" placeholder="Digite para buscar um produto..." class="search-input">
            </div>

            <!-- Lista de Produtos -->
            <div class="list-section">
                <h2>Lista de Produtos (<%= produtos.length %>)</h2>

                <% if (produtos.length === 0) { %>
                    <p class="empty-message">Nenhum produto cadastrado ainda. Use o formulário acima para adicionar.</p>
                <% } else { %>
                    <table class="product-table">
                        <thead>
                            <tr>
                                <th>Produto</th>
                                <th>Preço</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody id="productList">
                            <% produtos.forEach(produto => { %>
                                <tr>
                                    <td class="product-name"><%= produto.nome %></td>
                                    <td>R$ <%= Number(produto.preco).toFixed(2) %></td>
                                    <td class="actions">
                                        <a href="/editar/<%= produto.id %>" class="btn-edit">Editar</a>
                                        <a href="/excluir/<%= produto.id %>" onclick="return confirm('Tem certeza que deseja excluir este produto?')" class="btn-delete">Excluir</a>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } %>
            </div>
        </div>
    </main>

    <script src="/js/search.js"></script>

<%- include('partials/footer') %>